#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "counters.glsl"
#include "lattice.glsl"
#include "surface_footprint.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 7) uniform sampler2D colors;
layout(set = 0, binding = 4, r32ui) uniform readonly uimage2D lods;
#include "voxel_history.glsl"
struct Slot {
    uint owner, r, g, b, count, nearest;
};
layout(set = 0, binding = 8, std430) readonly buffer Hash {
    Slot slots[];
};
layout(set = 0, binding = 10, std430) writeonly buffer Instances {
    Voxel voxels[];
};
layout(set = 0, binding = 11, std430) readonly buffer Groups {
    uint offsets[];
};
layout(set = 0, binding = 14, std430) writeonly buffer LastSeen {
    float lastSeen[];
};
shared uint scan[256];
void main() {
    uint s = gl_GlobalInvocationID.x, local = gl_LocalInvocationID.x;
    bool valid = s < uint(params.extent.z) && slots[s].owner != 0u;
    scan[local] = valid ? 1u : 0u;
    barrier();
    for (uint stride = 1u; stride < 256u; stride <<= 1u) {
        uint previous = local >= stride ? scan[local - stride] : 0u;
        barrier();
        scan[local] += previous;
        barrier();
    }
    if (!valid)
        return;
    uint owner = slots[s].owner;
    ivec4 key = resolvedKey(owner);
    uint lod = uint(key.w), idx = offsets[gl_WorkGroupID.x] + scan[local] - 1u;
    float h = params.config.x * exp2(float(lod));
    if ((owner & CACHE_OWNER) != 0u) {
        uint previous = owner & ~CACHE_OWNER;
        voxels[idx] = cachedVoxels[previous];
        if (idx < CACHE_CAPACITY)
            lastSeen[idx] = cachedSeen[previous]; // never extend age without a fresh exact-cell hit
        atomicAdd(perLod[lod], 1u);
        return;
    }
    vec3 rgb = (slots[s].nearest & CACHE_OWNER) != 0u
                   ? uintBitsToFloat(uvec3(slots[s].r, slots[s].g, slots[s].b))
                   : params.flags.y == 1
                   ? vec3(slots[s].r, slots[s].g, slots[s].b) / (1023.0 * float(slots[s].count))
                   : texelFetch(colors, ownerPixel(slots[s].nearest), 0).rgb;
    voxels[idx].centerSize = vec4((vec3(key.xyz) + .5) * h, h * params.config.w);
    voxels[idx].rgba = vec4(rgb, 1);
    if (params.cache.y > 0 && idx < CACHE_CAPACITY)
        lastSeen[idx] = params.cache.x;
    atomicAdd(perLod[lod], 1u);
}
