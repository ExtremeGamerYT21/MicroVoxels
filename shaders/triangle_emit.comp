#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "lattice.glsl"
#define CANDIDATE_ACCESS
#include "triangle_cells.glsl"
layout(local_size_x = 64) in;
layout(set = 0, binding = 5, std430) readonly buffer CurrentRoots {
    Root currentRoots[];
};
layout(set = 0, binding = 9, std430) buffer Counters {
    uint vertexCount, instanceCount, firstVertex, firstInstance, hits, dropped, rootDropped,
        candidateCount;
    uint perLod[8];
};
void main() {
    uint tri = gl_WorkGroupID.x;
    if (tri >= uint(frame.options.w) || visible[tri] == 0u)
        return;
    vec3 a = vertices[tri * 3u].position.xyz, b = vertices[tri * 3u + 1u].position.xyz,
         c = vertices[tri * 3u + 2u].position.xyz;
    vec3 normal = cross(b - a, c - a);
    if (dot(normal, normal) < 1e-20)
        return;
    vec3 lo = min(a, min(b, c)), hi = max(a, max(b, c));
    float rh = regionSize();
    ivec3 begin = max(ivec3(floor(lo / rh - CELL_EPSILON)), params.gridMin.xyz);
    ivec3 end =
        min(ivec3(floor(hi / rh + CELL_EPSILON)), params.gridMin.xyz + params.gridExtent.xyz - 1);
    ivec3 dims = end - begin + 1;
    uint count = uint(dims.x * dims.y * dims.z);
    for (uint index = gl_LocalInvocationID.x; index < count; index += 64u) {
        uint x = uint(dims.x), y = uint(dims.y);
        ivec3 root = begin + ivec3(int(index % x), int((index / x) % y), int(index / (x * y)));
        if (!regionInView(root) || !triangleBox(a, b, c, (vec3(root) + .5) * rh, rh))
            continue;
        uint lod = currentRoots[regionIndex(root)].lod;
        int span = 1 << (5 - int(lod));
        float h = params.config.x * exp2(float(lod));
        ivec3 first = max(ivec3(floor(lo / h - CELL_EPSILON)), root * span);
        ivec3 last = min(ivec3(floor(hi / h + CELL_EPSILON)), (root + 1) * span - 1);
        for (int z = first.z; z <= last.z; z++)
            for (int y = first.y; y <= last.y; y++)
                for (int x = first.x; x <= last.x; x++) {
                    ivec3 cell = ivec3(x, y, z);
                    if (!triangleBox(a, b, c, (vec3(cell) + .5) * h, h))
                        continue;
                    uint id = atomicAdd(candidateCount, 1u);
                    if (id >= uint(params.gridExtent.w)) {
                        atomicAdd(dropped, 1u);
                        continue;
                    }
                    candidates[id].key = ivec4(cell, int(lod));
                    candidates[id].source = uvec4(tri, 0, 0, 0);
                }
    }
}
