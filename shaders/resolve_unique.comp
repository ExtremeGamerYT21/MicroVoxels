#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "counters.glsl"
#include "lattice.glsl"
#include "surface_footprint.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 7) uniform sampler2D colors;
layout(set = 0, binding = 4, r32ui) uniform readonly uimage2D lods;
struct Slot {
    uint owner, r, g, b, count, nearest;
};
layout(set = 0, binding = 8, std430) readonly buffer Hash {
    Slot slots[];
};
#include "instance_output.glsl"
layout(set = 0, binding = 12, std430) readonly buffer UniqueSlots {
    uint uniqueSlots[];
};
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= instanceCount)
        return;
    uint s = uniqueSlots[idx];
    ivec2 p = ownerPixel(slots[s].owner);
    ivec4 key = voxelKey(sourcePosition(p).xyz, imageLoad(lods, p).r);
    key.xyz += ownerOffset(slots[s].owner);
    uint lod = uint(key.w);
    vec3 rgb = params.flags.y == 1
                   ? vec3(slots[s].r, slots[s].g, slots[s].b) / (1023.0 * float(slots[s].count))
                   : texelFetch(colors, ownerPixel(slots[s].nearest), 0).rgb;
    storeInstance(idx, key, rgb);
    atomicAdd(perLod[lod], 1u);
}
