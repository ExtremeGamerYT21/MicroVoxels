#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "lattice.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D positions;
layout(set = 0, binding = 2) uniform sampler2D previousPositions;
layout(set = 0, binding = 5, std430) buffer CurrentRoots {
    Root currentRoots[];
};
layout(set = 0, binding = 6, std430) readonly buffer PreviousRoots {
    Root previousRoots[];
};
layout(set = 0, binding = 9, std430) buffer Counters {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
    uint hits;
    uint dropped;
    uint rootDropped;
    uint pad;
    uint perLod[8];
};
vec3 sampleStep(ivec2 p, ivec2 axis, vec3 hit) {
    vec3 step = vec3(0);
    float nearest = 3.402823e38;
    for (int sign = -1; sign <= 1; sign += 2) {
        ivec2 q = p + sign * axis;
        if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, params.extent.xy)))
            continue;
        vec4 neighbor = texelFetch(positions, q, 0);
        if (neighbor.w == 0)
            continue;
        vec3 delta = neighbor.xyz - hit;
        float separation = dot(delta, delta);
        // Prefer the closer neighbor to avoid spanning an occlusion boundary.
        if (separation < nearest) {
            nearest = separation;
            step = abs(delta);
        }
    }
    return step;
}
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, params.extent.xy)))
        return;
    vec4 hit = texelFetch(positions, p, 0);
    if (hit.w == 0)
        return;
    ivec3 root = rootCell(hit.xyz);
    float d = distance(rootCenter(root), frame.cameraTime.xyz);
    int old = -1;
    uint slot = hashKey(ivec4(root, 0)) & (ROOT_CAPACITY - 1);
    for (uint i = 0; i < 64; i++) {
        Root previous = previousRoots[(slot + i) & (ROOT_CAPACITY - 1)];
        uint id = previous.owner;
        if (id == 0)
            break;
        ivec2 q = pixel(id - 1);
        if (all(equal(rootCell(texelFetch(previousPositions, q, 0).xyz), root))) {
            old = int(previous.lod);
            break;
        }
    }
    int lod = distanceLod(d, old);
    if (frame.options.y != 0) {
        vec3 span = sampleStep(p, ivec2(1, 0), hit.xyz) + sampleStep(p, ivec2(0, 1), hit.xyz);
        float footprint = 1.25 * max(span.x, max(span.y, span.z));
        lod = max(lod, coverageLod(footprint, old));
    }
    uint id = uint(p.y * params.extent.x + p.x) + 1;
    for (uint i = 0; i < 64; i++) {
        uint s = (slot + i) & (ROOT_CAPACITY - 1);
        uint owner = atomicCompSwap(currentRoots[s].owner, 0, id);
        if (owner == 0 ||
            all(equal(rootCell(texelFetch(positions, pixel(owner - 1), 0).xyz), root))) {
            atomicMax(currentRoots[s].lod, uint(lod));
            return;
        }
    }
    atomicAdd(rootDropped, 1);
}
