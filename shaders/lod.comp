#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "lattice.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
#include "counters.glsl"
#include "surface_footprint.glsl"
layout(set = 0, binding = 2) uniform sampler2D previousPositions;
layout(set = 0, binding = 5, std430) buffer CurrentRoots {
    Root currentRoots[];
};
layout(set = 0, binding = 6, std430) readonly buffer PreviousRoots {
    Root previousRoots[];
};
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, params.extent.xy)))
        return;
    vec4 hit = texelFetch(positions, p, 0);
    if (hit.w == 0)
        return;
    ivec3 root = rootCell(hit.xyz);
    float d = distance(rootCenter(root), frame.cameraTime.xyz);
    int old = -1;
    uint lastChangeMs = 0u;
    uint slot = hashKey(ivec4(root, 0)) & (ROOT_CAPACITY - 1);
    for (uint i = 0; i < 64; i++) {
        Root previous = previousRoots[(slot + i) & (ROOT_CAPACITY - 1)];
        uint id = previous.owner;
        if (id == 0)
            break;
        ivec2 q = pixel(id - 1);
        if (all(equal(rootCell(texelFetch(previousPositions, q, 0).xyz), root))) {
            old = int(previous.lod);
            lastChangeMs = previous.lastChangeMs;
            break;
        }
    }
    int lod = distanceLod(d, old);
    if (frame.options.y != 0) {
        Footprint estimate = rawFootprint(p, hit.xyz);
        vec3 span = abs(estimate.dx) + abs(estimate.dy);
        float footprint = 1.25 * max(span.x, max(span.y, span.z));
        lod = max(lod, coverageLod(footprint, old));
    }
    // Briefly hold a region's settled pitch so aliased grass derivatives cannot
    // toggle its entire cell grid every frame. Every sample uses the same timer.
    if (params.cache.y > 0 && params.cache.w != 0 && old >= 0 &&
        uint(params.cache.x * 1000) - lastChangeMs < uint(params.cache.y * 1000))
        lod = old;
    uint id = uint(p.y * params.extent.x + p.x) + 1;
    for (uint i = 0; i < 64; i++) {
        uint s = (slot + i) & (ROOT_CAPACITY - 1);
        uint owner = atomicCompSwap(currentRoots[s].owner, 0, id);
        if (owner == 0 ||
            all(equal(rootCell(texelFetch(positions, pixel(owner - 1), 0).xyz), root))) {
            atomicMax(currentRoots[s].lod, uint(lod));
            return;
        }
    }
    atomicAdd(rootDropped, 1);
}
