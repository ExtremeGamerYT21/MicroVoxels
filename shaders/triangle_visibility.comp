#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 11) uniform usampler2D triangleIds;
layout(set = 0, binding = 13, std430) buffer VisibleTriangles {
    uint visible[];
};
layout(set = 0, binding = 9, std430) buffer Counters {
    uint vertexCount, instanceCount, firstVertex, firstInstance, hits, dropped, rootDropped,
        candidateCount;
    uint perLod[8];
};
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, params.extent.xy)))
        return;
    uint id = texelFetch(triangleIds, p, 0).r;
    if (id != 0u && id <= uint(frame.options.w)) {
        atomicOr(visible[id - 1u], 1u);
        atomicAdd(hits, 1u);
    }
}
